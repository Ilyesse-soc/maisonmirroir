# PayPal — Récupère ton Client ID sur developer.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend — Crée un compte sur resend.com et génère une clé API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email expéditeur vérifié en production via Resend
EMAIL_FROM=contact@maison-miroir.fr

# Email admin/vendeuse qui reçoit les commandes
EMAIL_ADMIN=maison.miroirs@gmail.com

# Fallback interne si EMAIL_FROM / EMAIL_ADMIN ne sont pas définis
OWNER_EMAIL=maison.miroirs@gmail.com
