NODE_ENV=production
NEWSLETTER_DATABASE_URL=postgresql://mm_app:GENERATED_PASSWORD@postgres:5432/maison_miroir?mm_schema=mm_live
NEWSLETTER_SITE_URL=https://maison-miroir.fr
BETTER_AUTH_URL=https://maison-miroir.fr
BETTER_AUTH_SECRET=GENERATE_48_RANDOM_BYTES
NEWSLETTER_HASH_SECRET=GENERATE_48_RANDOM_BYTES
NEWSLETTER_WORKER_SECRET=GENERATE_48_RANDOM_BYTES
CRON_SECRET=GENERATE_48_RANDOM_BYTES
OWNER_EMAIL=PROVIDE_OWNER_CONTACT
ADMIN_EMAIL=PROVIDE_OWNER_CONTACT
EMAIL_FROM=PROVIDE_VERIFIED_RESEND_SENDER
RESEND_API_KEY=PROVIDE_EXISTING_KEY_WITHOUT_ROTATING
RESEND_NEWSLETTER_WEBHOOK_SECRET=PROVIDE_SIGNED_WEBHOOK_SECRET
SHOP_OPEN=false
PAYPAL_CLIENT_ID=PROVIDE_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=PROVIDE_SANDBOX_CLIENT_SECRET
PAYPAL_MERCHANT_ID=PROVIDE_SANDBOX_MERCHANT_ID
PAYPAL_WEBHOOK_ID=PROVIDE_SANDBOX_WEBHOOK_ID
PAYPAL_ENV=sandbox
NEWSLETTER_AUTO_PUBLISH=false
NEWSLETTER_SEND_ENABLED=false
NEWSLETTER_DAILY_CONFIRMATION_LIMIT=100
NEWSLETTER_RETENTION_DAYS=1095
GEMINI_MODEL=gemini-3.8-flash
# Optional: add GEMINI_API_KEY only to the protected server-side environment after checking account access and quota.
# Optional fallback provider; add GROQ_API_KEY only to the protected server-side environment.
GROQ_MODEL=llama-3.3-70b-versatile
