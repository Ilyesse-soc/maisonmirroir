# PayPal - Utilise les identifiants Sandbox pendant les tests
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend - Crée un compte sur resend.com et génère une clé API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email expéditeur vérifié en production via Resend
EMAIL_FROM=contact@maison-miroir.fr

# Email admin/vendeuse qui reçoit les commandes
EMAIL_ADMIN=maison.miroirs@gmail.com

# Fallback interne si EMAIL_FROM / EMAIL_ADMIN ne sont pas définis
OWNER_EMAIL=maison.miroirs@gmail.com

# Launch page / newsletter - do not copy real credentials into this example
SHOP_OPEN=false
ADMIN_EMAIL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://maison-miroir.fr
INSTAGRAM_URL=
TIKTOK_URL=
NEWSLETTER_DATABASE_URL=
NEWSLETTER_SITE_URL=https://maison-miroir.fr
NEWSLETTER_HASH_SECRET=
NEWSLETTER_WORKER_SECRET=
RESEND_NEWSLETTER_WEBHOOK_SECRET=
NEWSLETTER_RETENTION_DAYS=1095
NEWSLETTER_AUTO_PUBLISH=false
NEWSLETTER_SEND_ENABLED=false
NEWSLETTER_BATCH_SIZE=5
NEWSLETTER_DAILY_CONFIRMATION_LIMIT=100
DATABASE_POOL_MAX=3
DATABASE_CA_FILE=
CRON_SECRET=
# Server-side verification is mandatory before reopening payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Mondial Relay: identifiants strictement côté serveur, jamais dans le navigateur.
# Tous les accès de production et les garde-fous commerciaux restent désactivés
# tant que contrat, service, mode, colis et tarifs ne sont pas explicitement confirmés.
MONDIAL_RELAY_PRODUCTION_CONFIRMED=false
MONDIAL_RELAY_API1_PROD_SHOP=
MONDIAL_RELAY_API1_PROD_PRIVATE_KEY=
MONDIAL_RELAY_API1_PROD_ENABLED=false
MONDIAL_RELAY_API2_PROD_LOGIN=
MONDIAL_RELAY_API2_PROD_PASSWORD=
MONDIAL_RELAY_API2_PROD_CUSTOMER_ID=
MONDIAL_RELAY_API2_PROD_URL=https://connect-api.mondialrelay.com/api/shipment
MONDIAL_RELAY_API2_PROD_ENABLED=false
REAL_SHIPPING_ENABLED=false
REAL_SHIPMENT_CREATION_ENABLED=false
REAL_PAYMENTS_ENABLED=false
